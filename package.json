{
  "name": "@thepia/flows-client",
  "version": "1.0.3",
  "description": "Multi-client database management for Thepia Flows applications",
  "type": "module",
  "comments": {
    "devDependencies": {
      "@thepia/flows-auth": "TYPES ONLY - Used for SessionPersistence, SessionData, and UserData type definitions. No runtime code imported."
    }
  },
  "main": "dist/flows-client.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": {
        "svelte": "./src/lib/flows-client.ts",
        "types": "./src/lib/flows-client.ts"
      },
      "import": "./dist/flows-client.js",
      "require": "./dist/flows-client.js",
      "default": "./dist/flows-client.js"
    },
    "./svelte": {
      "types": "./src/types/index.ts",
      "import": "./src/svelte.ts",
      "default": "./src/svelte.ts"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "import": "./src/types/index.ts",
      "default": "./src/types/index.ts"
    },
    "./client": {
      "types": "./src/lib/flows-client.ts",
      "import": "./dist/flows-client.js",
      "default": "./dist/flows-client.js"
    },
    "./flows-sw.js": {
      "import": "./dist/flows-sw.js",
      "default": "./dist/flows-sw.js"
    }
  },
  "scripts": {
    "prepare": "husky",
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "test:unit": "vitest run --exclude '**/service-worker-bundle.test.ts' --exclude '**/service-worker-execution.test.ts'",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm build:sw && pnpm build:client && tsc --noEmit",
    "build:sw": "vite build --config vite.sw.config.ts",
    "build:client": "vite build --config vite.client.config.ts",
    "db:init": "node scripts/init-database.js",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed-database.js",
    "db:reset": "node scripts/reset-database.js",
    "db:backup": "node scripts/backup.js",
    "db:restore": "node scripts/restore.js",
    "db:setup-rls": "node scripts/setup-rls.js",
    "client:create": "node scripts/setup-client.js",
    "client:list": "node scripts/list-clients.js",
    "client:status": "node scripts/client-status.js",
    "client:update": "node scripts/update-client.js",
    "client:deactivate": "node scripts/deactivate-client.js",
    "client:analytics": "node scripts/client-analytics.js",
    "invitation:create": "node scripts/create-invitation.js",
    "invitation:validate": "node scripts/validate-invitation.js",
    "invitation:list": "node scripts/list-invitations.js",
    "invitation:revoke": "node scripts/revoke-invitation.js",
    "invitation:cleanup": "node scripts/cleanup-invitations.js",
    "admin:assign": "node scripts/manage-admin-users.js assign",
    "admin:remove": "node scripts/manage-admin-users.js remove",
    "admin:list": "node scripts/manage-admin-users.js list",
    "admin:check": "node scripts/manage-admin-users.js check",
    "admin:test": "node scripts/manage-admin-users.js test",
    "health-check": "node scripts/health-check.js",
    "analytics:usage": "node scripts/usage-analytics.js",
    "maintenance": "node scripts/maintenance.js",
    "offboarding:deploy-schema": "node scripts/deploy-task-offboarding-schema.js",
    "offboarding:create-templates": "node scripts/create-offboarding-templates-demo.js",
    "docs:generate": "node scripts/generate-docs.js",
    "docs:serve": "npx http-server docs/ -p 8080",
    "install:auth": "./scripts/install-with-auth.sh",
    "demo:setup": "node demo/scripts/setup-demo.js run",
    "demo:setup:status": "node demo/scripts/setup-demo.js status",
    "demo:populate": "node demo/scripts/populate-full-demo.js run",
    "demo:populate-rich": "node demo/scripts/populate-rich-demo.js run",
    "demo:complete": "node demo/scripts/setup-complete-demo.js run",
    "demo:refresh": "node demo/scripts/refresh-demo.js run",
    "demo:reset": "node demo/scripts/reset-demo.js run",
    "demo:analytics": "node demo/scripts/analytics.js run",
    "demo:admin": "pnpm --filter flows-admin-demo dev",
    "demo:admin:build": "pnpm --filter flows-admin-demo build",
    "demo:admin:install": "pnpm --filter flows-admin-demo install",
    "demo:build": "pnpm --filter flows-admin-demo build",
    "demo:verify": "vitest run tests/demo-complete-verification.spec.js",
    "demo:verify:watch": "vitest tests/demo-complete-verification.spec.js",
    "demo:verify:quick": "node scripts/verify-demo-complete.js",
    "demo:screenshots": "playwright test tests/e2e/promotional-screenshots.spec.ts --headed",
    "demo:screenshots:ci": "playwright test tests/e2e/promotional-screenshots.spec.ts",
    "demo:screenshots:all": "playwright test tests/e2e/promotional-screenshots.spec.ts --project=promotional-screenshots --project=tablet-screenshots",
    "demo:screenshots:copy": "node scripts/copy-screenshots-to-thepia.js",
    "demo:screenshots:full": "pnpm demo:screenshots:all && pnpm demo:screenshots:copy",
    "offboarding:demo-data": "node scripts/create-offboarding-demo-data.js"
  },
  "keywords": [
    "thepia",
    "flows",
    "database",
    "multi-tenant",
    "supabase",
    "postgres",
    "rls",
    "jwt",
    "invitations",
    "gdpr"
  ],
  "author": "Thepia <dev@thepia.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thepia/flows-client.git"
  },
  "bugs": {
    "url": "https://github.com/thepia/flows-client/issues"
  },
  "homepage": "https://github.com/thepia/flows-client#readme",
  "files": [
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "package.json",
    "src/types/",
    "src/lib/flows-client.ts",
    "dist/flows-sw.js",
    "dist/flows-sw.js.map",
    "dist/flows-client.js",
    "dist/flows-client.js.map",
    "scripts/copy-sw.js",
    "schemas/",
    "tests/",
    "docs/"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "dotenv": "^16.3.1",
    "inquirer": "^9.2.12",
    "joi": "^17.11.0",
    "jose": "^5.2.0",
    "node-cron": "^3.0.3",
    "ora": "^7.0.1",
    "sharp": "^0.34.2",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.0",
    "@playwright/test": "^1.53.1",
    "@thepia/flows-auth": "^1.0.14",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@vitest/coverage-v8": "^4.0.0",
    "fake-indexeddb": "^6.2.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.1.0",
    "service-worker-mock": "^2.0.5",
    "typescript": "^5.3.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "publishConfig": {
    "access": "public",
    "@thepia:registry": "https://npm.pkg.github.com"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "volta": {
    "node": "22.11.0",
    "npm": "10.9.0"
  },
  "lint-staged": {
    "*": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "vitest": {
    "environment": "node",
    "coverage": {
      "provider": "v8",
      "reporter": [
        "text",
        "json",
        "html"
      ],
      "exclude": [
        "node_modules/**",
        "tests/**",
        "*.config.js"
      ]
    }
  }
}
